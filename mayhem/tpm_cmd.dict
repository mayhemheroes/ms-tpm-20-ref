# libFuzzer dictionary for the ms-tpm-20-ref TPM 2.0 command-dispatch fuzzer (tpm_cmd).
# The harness reads big-endian TPM2 command framing: tag(2) | size(4) | commandCode(4) | body.
# It fixes up tag/size and (only if out of range) the command code, so feeding real tags +
# command codes + capability selectors steers the parser into valid dispatch paths.

# --- structure tags (TPM_ST), big-endian ---
tag_no_sessions="\x80\x01"
tag_sessions="\x80\x02"

# --- common, well-framed full commands (tag|size|cc[|args]) ---
startup_clear="\x80\x01\x00\x00\x00\x0c\x00\x00\x01\x44\x00\x00"
startup_state="\x80\x01\x00\x00\x00\x0c\x00\x00\x01\x44\x00\x01"
shutdown_clear="\x80\x01\x00\x00\x00\x0c\x00\x00\x01\x45\x00\x00"
shutdown_state="\x80\x01\x00\x00\x00\x0c\x00\x00\x01\x45\x00\x01"
selftest_full="\x80\x01\x00\x00\x00\x0b\x00\x00\x01\x43\x01"
getrandom_8="\x80\x01\x00\x00\x00\x0c\x00\x00\x01\x7b\x00\x08"
getcap_props="\x80\x01\x00\x00\x00\x16\x00\x00\x01\x7a\x00\x00\x00\x06\x00\x00\x01\x05\x00\x00\x00\x01"

# --- bare command codes (big-endian), for the harness's command_code field ---
cc_NV_UndefineSpaceSpecial="\x00\x00\x01\x1f"
cc_EvictControl="\x00\x00\x01\x20"
cc_HierarchyControl="\x00\x00\x01\x21"
cc_Clear="\x00\x00\x01\x26"
cc_ClearControl="\x00\x00\x01\x27"
cc_NV_DefineSpace="\x00\x00\x01\x2a"
cc_CreatePrimary="\x00\x00\x01\x31"
cc_NV_Write="\x00\x00\x01\x37"
cc_SelfTest="\x00\x00\x01\x43"
cc_Startup="\x00\x00\x01\x44"
cc_Shutdown="\x00\x00\x01\x45"
cc_StirRandom="\x00\x00\x01\x46"
cc_Certify="\x00\x00\x01\x48"
cc_NV_Read="\x00\x00\x01\x4e"
cc_Create="\x00\x00\x01\x53"
cc_HMAC="\x00\x00\x01\x55"
cc_Load="\x00\x00\x01\x57"
cc_Quote="\x00\x00\x01\x58"
cc_RSA_Decrypt="\x00\x00\x01\x59"
cc_Sign="\x00\x00\x01\x5d"
cc_Unseal="\x00\x00\x01\x5e"
cc_ContextLoad="\x00\x00\x01\x61"
cc_ContextSave="\x00\x00\x01\x62"
cc_EncryptDecrypt="\x00\x00\x01\x64"
cc_FlushContext="\x00\x00\x01\x65"
cc_LoadExternal="\x00\x00\x01\x67"
cc_PolicyOR="\x00\x00\x01\x71"
cc_ReadPublic="\x00\x00\x01\x73"
cc_RSA_Encrypt="\x00\x00\x01\x74"
cc_StartAuthSession="\x00\x00\x01\x76"
cc_ECC_Parameters="\x00\x00\x01\x78"
cc_GetCapability="\x00\x00\x01\x7a"
cc_GetRandom="\x00\x00\x01\x7b"
cc_Hash="\x00\x00\x01\x7d"
cc_PCR_Read="\x00\x00\x01\x7e"
cc_PCR_Extend="\x00\x00\x01\x82"
cc_CreateLoaded="\x00\x00\x01\x91"
cc_ECC_Decrypt="\x00\x00\x01\x9a"

# --- GetCapability capability selectors (TPM_CAP), big-endian ---
cap_algs="\x00\x00\x00\x00"
cap_handles="\x00\x00\x00\x01"
cap_commands="\x00\x00\x00\x02"
cap_pcrs="\x00\x00\x00\x05"
cap_tpm_properties="\x00\x00\x00\x06"

# --- startup type (TPM_SU) ---
su_clear="\x00\x00"
su_state="\x00\x01"
